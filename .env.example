# ── LLM provider: local | deepinfra | gcp ────────────────────────────────
SOMBEER_LLM__PROVIDER=local

# local (llama-server / Ollama, OpenAI-compatible endpoint)
SOMBEER_LLM__MODEL=/opt/llm/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
SOMBEER_LLM__BASE_URL=http://127.0.0.1:11434/v1
SOMBEER_LLM__API_KEY=not-needed
SOMBEER_LLM__TEMPERATURE=0.3

# deepinfra (set PROVIDER=deepinfra and fill these)
SOMBEER_LLM__DI_MODEL=Qwen/Qwen2.5-72B-Instruct
SOMBEER_LLM__DI_API_KEY=

# gcp (set PROVIDER=gcp and fill these; needs gcloud auth)
SOMBEER_LLM__GCP_MODEL=gemini-2.0-flash
SOMBEER_LLM__GCP_PROJECT=
SOMBEER_LLM__GCP_LOCATION=us-central1

# ── Weaviate ─────────────────────────────────────────────────────────────
SOMBEER_WEAVIATE__HOST=localhost
SOMBEER_WEAVIATE__PORT=8080
SOMBEER_WEAVIATE__GRPC_PORT=50051
SOMBEER_WEAVIATE__COLLECTION=Beer
SOMBEER_WEAVIATE__LIMIT=5

# ── Phoenix (Arize) tracing ──────────────────────────────────────────────
SOMBEER_PHOENIX__ENABLED=true
SOMBEER_PHOENIX__ENDPOINT=http://localhost:6006
SOMBEER_PHOENIX__API_KEY=
