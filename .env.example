# ── LLM provider: local | deepinfra | gcp ────────────────────────────────
SOMMEBEER_LLM__PROVIDER=local

# local (llama-server / Ollama, OpenAI-compatible endpoint)
SOMMEBEER_LLM__MODEL=/opt/llm/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
SOMMEBEER_LLM__BASE_URL=http://127.0.0.1:11434/v1
SOMMEBEER_LLM__API_KEY=not-needed
SOMMEBEER_LLM__TEMPERATURE=0.3

# deepinfra (set PROVIDER=deepinfra and fill these)
SOMMEBEER_LLM__DI_MODEL=Qwen/Qwen2.5-72B-Instruct
SOMMEBEER_LLM__DI_API_KEY=

# gcp (set PROVIDER=gcp and fill these; needs gcloud auth)
SOMMEBEER_LLM__GCP_MODEL=gemini-2.0-flash
SOMMEBEER_LLM__GCP_PROJECT=
SOMMEBEER_LLM__GCP_LOCATION=us-central1

# ── Weaviate ─────────────────────────────────────────────────────────────
SOMMEBEER_WEAVIATE__HOST=localhost
SOMMEBEER_WEAVIATE__PORT=8080
SOMMEBEER_WEAVIATE__GRPC_PORT=50051
SOMMEBEER_WEAVIATE__COLLECTION=Beer
SOMMEBEER_WEAVIATE__LIMIT=5

# ── Phoenix (Arize) tracing ──────────────────────────────────────────────
SOMMEBEER_PHOENIX__ENABLED=true
SOMMEBEER_PHOENIX__ENDPOINT=http://localhost:6006
SOMMEBEER_PHOENIX__API_KEY=
